@using System
@using System.Linq
@using Hexagon.Logic
@using Sandbox
@using Sandbox.UI
@namespace Hexagon.UI
@inherits Panel

@* What this character carries, and the holder it has open beside it. Items are dragged: to another
   cell, onto a pile of the same thing, across into the other grid, or out of both, onto the ground. *@
<root class="center" ondrop=@DropOnGround>
	@if ( Player.Local is { Inventory: { } inventory } player )
	{
		@if ( player.OpenInventory is { } other )
		{
			<div class="card" ondrop=@DropInOpen>
				<h1>@player.OpenTitle</h1>
				<div class="grid" style="width: @(other.Width * Cell)px; height: @(other.Height * Cell)px;">
					@for ( var y = 0; y < other.Height; y++ )
					{
						@for ( var x = 0; x < other.Width; x++ )
						{
							<div class="cell" style="left: @(x * Cell)px; top: @(y * Cell)px;"></div>
						}
					}
					@foreach ( var item in Wearing.Carried( other ) )
					{
						var taken = item;
						<ItemTile class=@TileClass( item, selectable: false ) style=@Place( item ) Item=@item InOpenHolder=@true
							onclick=@(() => player.RequestTake( taken.Id ))
							ondragstart=@(( PanelEvent e ) => BeginDrag( e )) ondragend=@(() => EndDrag()) />
					}
				</div>
				@if ( Wearing.Worn( other ).Any() )
				{
					<label>Wearing</label>
					<div class="row wrap wearing">
						@foreach ( var item in Wearing.Worn( other ) )
						{
							var taken = item;
							<ItemTile class="item" Item=@item InOpenHolder=@true onclick=@(() => player.RequestTake( taken.Id ))
								ondragstart=@(( PanelEvent e ) => BeginDrag( e )) ondragend=@(() => EndDrag()) />
						}
					</div>
				}
				<div class="actions">
					<button onclick=@(() => player.RequestCloseHolder())>Close</button>
				</div>
				<div class="muted">Click an item, or drag it across, to take it. What they wear comes off them.</div>
			</div>
		}
		<div class="card" ondrop=@DropOnCard>
			<h1>@player.CharacterName</h1>
			<div class="row">
				<div class="muted grow">@(player.Faction is { } faction ? player.RankTitle.Length > 0 ? $"{faction.Title}, {player.RankTitle}" : faction.Title : "Unaffiliated")</div>
				@if ( player.Faction is not null )
				{
					@* Walking out is for good, so it takes a second click. *@
					<button onclick=@(() => WalkOut( player ))>@(WalkingOut ? "Walk out for good" : "Walk out")</button>
				}
			</div>
			<label>Wearing</label>
			<div class="row wrap wearing" ondrop=@DropOnWorn>
				@foreach ( var item in Wearing.Worn( inventory ) )
				{
					var piece = item;
					<ItemTile class=@TileClass( item, selectable: true ) Item=@item InOpenHolder=@false
						onclick=@(() => Selected = Selected == piece.Id ? null : piece.Id)
						ondragstart=@(( PanelEvent e ) => BeginDrag( e )) ondragend=@(() => EndDrag()) />
				}
				@if ( !Wearing.Worn( inventory ).Any() )
				{
					<div class="muted">Nothing. Drag clothes here to put them on.</div>
				}
			</div>
			<div class="grid" style="width: @(inventory.Width * Cell)px; height: @(inventory.Height * Cell)px;"
				ondrop=@DropInInventory>
				@for ( var y = 0; y < inventory.Height; y++ )
				{
					@for ( var x = 0; x < inventory.Width; x++ )
					{
						<div class="cell" style="left: @(x * Cell)px; top: @(y * Cell)px;"></div>
					}
				}
				@foreach ( var item in Wearing.Carried( inventory ) )
				{
					var carried = item;
					<ItemTile class=@TileClass( item, selectable: true ) style=@Place( item ) Item=@item InOpenHolder=@false
						onclick=@(() => Selected = Selected == carried.Id ? null : carried.Id)
						ondragstart=@(( PanelEvent e ) => BeginDrag( e )) ondragend=@(() => EndDrag())
						ondrop=@(( PanelEvent e ) => DropOnPile( e, carried )) />
				}
			</div>
			@if ( SelectedDefinition is { IsRadio: true } )
			{
				<div class="row">
					<TextEntry class="grow" Value:bind="@FrequencyDraft" MaxLength="@(5)" Placeholder="100.0 to 199.9" onsubmit=@TuneSelected />
					<button onclick=@TuneSelected>Tune</button>
				</div>
				<div class="muted">Speak into it with /r. Anyone tuned the same hears you; so does anyone beside you.</div>
			}
			@if ( SelectedDefinition is { IsKey: true } )
			{
				<div class="muted">A key shows its cut. Keys cut the same open the same locks; which ones, you learn by trying.</div>
			}
			@if ( SelectedDefinition is { IsPaper: true } )
			{
				<div class="muted">Read it to write on it, fill it in or stamp it. Writing takes a pen or a pencil, and ink stays.</div>
			}
			@if ( SelectedDefinition is { IsMap: true } )
			{
				<div class="muted">Lay it out on the table in front of you, then lean over it to mark it up with whoever else is there.</div>
			}
			<div class="actions">
				@if ( SelectedStack is { Worn: true } )
				{
					@* Something worn is only taken off: anything else is done with it once it is carried. *@
					<button class="primary" onclick=@(() => ActOnSelected( VerbIds.ItemWear ))>Take off</button>
				}
				else
				{
					@if ( SelectedDefinition is { Wearable: not null } )
					{
						<button class="primary" onclick=@(() => ActOnSelected( VerbIds.ItemWear ))>Put on</button>
					}
					@if ( player.OpenInventory is not null )
					{
						<button disabled=@(Selected is null) onclick=@(() => ActOnSelected( "put" ))>Put in</button>
					}
					@if ( SelectedDefinition is { IsPaper: true } )
					{
						<button class="primary" onclick=@(() => ReadSelected())>Read</button>
					}
					@if ( SelectedDefinition is { IsMap: true } )
					{
						<button class="primary" onclick=@(() => ActOnSelected( VerbIds.ItemLayOut ))>Lay out</button>
					}
					@if ( SelectedDefinition is { Consumable: true } usable )
					{
						<button class="primary" onclick=@(() => ActOnSelected( VerbIds.ItemUse ))>@usable.UseTitle</button>
					}
					@if ( SelectedStack is { Count: > 1 } pile )
					{
						<button onclick=@(() => SplitSelected( pile ))>Split off @(pile.Count / 2)</button>
					}
					<button disabled=@(Selected is null) onclick=@(() => ActOnSelected( VerbIds.ItemEquip ))>Hold</button>
					<button disabled=@(Selected is null) onclick=@(() => ActOnSelected( VerbIds.ItemDrop ))>Drop</button>
				}
				<button onclick=@(() => player.RequestLeaveCity())>Leave the city</button>
			</div>
			<div class="muted">Click an item to choose it. Drag it to move it, onto a pile of the same thing to add to it, across to put it in, or out of the window to drop it. What you wear comes off into your pockets, if there is room.</div>
		</div>
		@if ( DraggedStack is { } lifted )
		{
			var at = MousePosition * ScaleFromScreen - _grab;
			<ItemTile class="item ghost" Item=@lifted style=@($"left: {at.x}px; top: {at.y}px; width: {lifted.Width * Cell - 4}px; height: {lifted.Height * Cell - 4}px;") />
		}
	}
</root>

@code
{
	// One grid cell and the gap after it, in panel pixels. A cell, and a one-cell item, is 4 less (see .cell).
	private const int Cell = 76;

	private Guid? Selected { get; set; }
	private string FrequencyDraft { get; set; } = string.Empty;
	/// <summary>Walking out of the faction was asked once, and waits for the second click.</summary>
	private bool WalkingOut { get; set; }

	private void WalkOut( Player player )
	{
		if ( WalkingOut ) player.RequestLeaveFaction();
		WalkingOut = !WalkingOut;
	}

	// The pile being dragged, and where on it the mouse took hold, in panel units.
	private Guid? _dragging;
	private bool _draggingFromOpen;
	private Vector2 _grab;

	private ItemStack? SelectedStack => Player.Local?.Inventory?.Items.FirstOrDefault( value => value.Id == Selected );
	private ItemDefinition? SelectedDefinition => SelectedStack is { } stack ? ItemDefinition.Find( stack.Definition ) : null;

	/// <summary>Where a pile sits in its grid, and how big it is.</summary>
	private static string Place( ItemStack item ) =>
		$"left: {item.X * Cell}px; top: {item.Y * Cell}px; width: {item.Width * Cell - 4}px; height: {item.Height * Cell - 4}px;";

	private string TileClass( ItemStack item, bool selectable ) =>
		"item" + (selectable && item.Id == Selected ? " selected" : string.Empty) + (item.Id == _dragging ? " lifted" : string.Empty);

	private ItemStack? DraggedStack => _dragging is { } id
		? (_draggingFromOpen ? Player.Local?.OpenInventory : Player.Local?.Inventory)?.Items.FirstOrDefault( value => value.Id == id )
		: null;

	private void BeginDrag( PanelEvent e )
	{
		if ( e is not DragEvent drag || drag.Target is not ItemTile tile ) return;
		_dragging = tile.ItemId;
		_draggingFromOpen = tile.InOpenHolder;
		_grab = drag.LocalGrabPosition * ScaleFromScreen;
	}

	// The engine ends a drag before it delivers the drop, so a drop reads the tile it was handed.
	private void EndDrag() => _dragging = null;

	/// <summary>A carried pile let go of over another: on one of the same thing it joins it, otherwise the grid places it.</summary>
	private void DropOnPile( PanelEvent e, ItemStack onto )
	{
		if ( e.Target is not ItemTile { InOpenHolder: false } tile || tile.ItemId == onto.Id ) return;
		var dragged = Player.Local?.Inventory?.Items.FirstOrDefault( value => value.Id == tile.ItemId );
		if ( dragged is null || dragged.Definition != onto.Definition || onto.Max < 2 ) return;
		Player.Local?.RequestMoveItem( tile.ItemId, onto.X, onto.Y );
		e.StopPropagation();
	}

	/// <summary>Over this character's own grid: a carried pile moves to where it was let go; one from the open holder is taken; one worn is taken off.</summary>
	private void DropInInventory( PanelEvent e )
	{
		if ( e.Target is not ItemTile tile || Player.Local is not { } player ) return;
		e.StopPropagation();
		if ( tile.InOpenHolder )
		{
			player.RequestTake( tile.ItemId );
			return;
		}
		if ( tile.Item is { Worn: true } )
		{
			player.RequestItemAct( tile.ItemId, VerbIds.ItemWear );
			return;
		}
		// The cell under the pile's top left corner, as it was held.
		var corner = e.This.MousePosition * ScaleFromScreen - _grab;
		player.RequestMoveItem( tile.ItemId, (int)MathF.Round( corner.x / Cell ), (int)MathF.Round( corner.y / Cell ) );
	}

	/// <summary>Over the open holder: a carried pile is put in it.</summary>
	private void DropInOpen( PanelEvent e )
	{
		e.StopPropagation();
		if ( e.Target is ItemTile { InOpenHolder: false } tile ) Player.Local?.RequestPut( tile.ItemId );
	}

	/// <summary>Over what this character wears: something carried is put on.</summary>
	private void DropOnWorn( PanelEvent e )
	{
		e.StopPropagation();
		if ( e.Target is ItemTile { InOpenHolder: false, Item: { Worn: false } carried } tile && ItemDefinition.Find( carried.Definition ) is { Wearable: not null } )
			Player.Local?.RequestItemAct( tile.ItemId, VerbIds.ItemWear );
	}

	/// <summary>Over this character's own card but not its grid: nothing happens, rather than a drop on the ground.</summary>
	private void DropOnCard( PanelEvent e ) => e.StopPropagation();

	/// <summary>Outside both: a carried pile is put down on the ground, as the Drop button does.</summary>
	private void DropOnGround( PanelEvent e )
	{
		if ( e.Target is ItemTile { InOpenHolder: false } tile ) Player.Local?.RequestItemAct( tile.ItemId, VerbIds.ItemDrop );
	}

	private void TuneSelected()
	{
		if ( Selected is { } radio ) Player.Local?.RequestTune( radio, FrequencyDraft );
		FrequencyDraft = string.Empty;
	}

	private void ReadSelected()
	{
		if ( Selected is { } sheet ) Player.Local?.RequestRead( sheet );
	}

	private void SplitSelected( ItemStack pile )
	{
		Player.Local?.RequestSplitItem( pile.Id, pile.Count / 2 );
		Selected = null;
	}

	private void ActOnSelected( string verb )
	{
		if ( Selected is not { } item ) return;
		if ( verb == "put" ) Player.Local?.RequestPut( item );
		else Player.Local?.RequestItemAct( item, verb );
		Selected = null;
	}

	protected override int BuildHash() => HashCode.Combine(
		HashCode.Combine( Player.Local?.PrivateVersion, Player.Local?.OpenInventory, Selected, _dragging, WalkingOut ),
		// A dragged pile follows the mouse.
		_dragging is null ? 0 : MousePosition.GetHashCode() );
}
