@using System
@using Sandbox
@using Sandbox.UI
@namespace Hexagon.UI
@inherits PanelComponent

@* The HUD's shell. Each part is its own panel, rebuilt only when what it shows changes; this decides
   which are up, holds the keys that open and close them, and tells the player when a panel has the
   cursor. Its stylesheet reaches every part. *@
<root>
	@if ( Player.Local is not { } player )
	{
		<div class="center"><div class="card"><h1>Connecting…</h1></div></div>
	}
	else if ( !player.HasCharacter )
	{
		<CharacterSelect />
	}
	else
	{
		@if ( !Player.UiBusy && player is { HoveredTarget: IVerbTarget { Verbs.Count: > 0 }, HoveredTooltip: not null } )
		{
			<LookPrompt />
		}
		@if ( player.OfferText.Length > 0 )
		{
			<OfferPrompt Answering=@(!ChatOpen && player.MenuTarget is null && OfferingTo is null) />
		}
		@if ( player.MenuTarget is not null )
		{
			<VerbMenu OfferTo=@(( Player recipient ) => { OfferingTo = recipient; }) ShowTo=@(( Player reader ) => { ShowingTo = reader; }) />
		}
		@if ( OfferingTo is { } recipient )
		{
			<OfferPicker Recipient=@recipient Dismiss=@(() => { OfferingTo = null; }) />
		}
		@if ( ShowingTo is { } reader )
		{
			<OfferPicker Recipient=@reader Showing=@true Dismiss=@(() => { ShowingTo = null; }) />
		}
		@if ( !Player.UiBusy )
		{
			<KeyHints />
		}
		<ChatBox Open=@ChatOpen Dismiss=@(() => { ChatOpen = false; }) />
		@if ( StaffOpen && player.IsStaff )
		{
			<StaffConsole />
		}
		@if ( (InventoryOpen || player.OpenInventory is not null) && player.Inventory is not null )
		{
			<InventoryWindow />
		}
		@if ( player.Paper is not null )
		{
			<PaperWindow />
		}
	}
</root>

@code
{
	private bool ChatOpen { get; set; }
	// Static, as there is one HUD, so the tests can open a panel to take its picture; see Show.
	private static bool InventoryOpen { get; set; }
	private static bool StaffOpen { get; set; }
	/// <summary>Whoever this character is choosing something to offer to.</summary>
	private Player? OfferingTo { get; set; }
	/// <summary>Whoever this character is choosing a paper to hold up for.</summary>
	private Player? ShowingTo { get; set; }
	private GameObject? _harmCues;

	/// <summary>Opens one of the panels a key or a button opens, or closes them.</summary>
	public static void Show( HudPanel panel )
	{
		InventoryOpen = panel == HudPanel.Inventory;
		StaffOpen = panel == HudPanel.Staff;
		CharacterSelect.FormAsked = panel == HudPanel.NewCharacter;
	}

	protected override void OnStart()
	{
		base.OnStart();
		// How harm feels is drawn by the engine's post-processing, over the game's own camera, not by this panel.
		_harmCues = new GameObject( true, "Harm Cues" ) { NetworkMode = NetworkMode.Never };
		_harmCues.AddComponent<HarmCues>();
	}

	protected override void OnDestroy()
	{
		_harmCues?.Destroy();
		base.OnDestroy();
	}

	protected override void OnUpdate()
	{
		var local = Player.Local;
		Player.UiBusy = ChatOpen || InventoryOpen || StaffOpen || OfferingTo is not null || ShowingTo is not null || local?.OpenInventory is not null
			|| local?.MenuTarget is not null || local?.Paper is not null || local is not { HasCharacter: true };
		if ( local is not { HasCharacter: true } )
		{
			ChatOpen = false;
			InventoryOpen = false;
			OfferingTo = null;
			ShowingTo = null;
			return;
		}
		// A menu, a list of things to offer or show, or a sheet being read has the keys until it is closed; each closes itself.
		if ( local.MenuTarget is not null || OfferingTo is not null || ShowingTo is not null || local.Paper is not null ) return;

		if ( !ChatOpen && Input.Pressed( "Chat" ) )
		{
			ChatOpen = true;
			Input.Clear( "Chat" );
		}
		else if ( ChatOpen && Input.EscapePressed )
		{
			Input.EscapePressed = false;
			ChatOpen = false;
		}

		if ( !ChatOpen && Input.Pressed( "Menu" ) ) InventoryOpen = !InventoryOpen;
		if ( !ChatOpen && Input.Pressed( "Score" ) && local.IsStaff ) StaffOpen = !StaffOpen;
	}

	// Rebuild whenever which panels are up changes; each panel watches what it shows.
	protected override int BuildHash() => HashCode.Combine(
		HashCode.Combine( Player.Local, Player.Local?.HasCharacter, Player.Local?.OfferText, Player.Local?.MenuTarget, Player.Local?.IsStaff ),
		HashCode.Combine( Player.Local?.OpenInventory is null, Player.Local?.Inventory is null, Player.UiBusy ),
		HashCode.Combine( ChatOpen, InventoryOpen, StaffOpen, OfferingTo, ShowingTo, Player.Local?.Paper is null ),
		HashCode.Combine( Player.Local?.HoveredTarget, Player.Local?.HoveredTooltip is null ) );
}
