@using System
@using Sandbox
@using Sandbox.UI
@namespace Hexagon.UI
@inherits Panel

@* Sitting in a vehicle: which, at its wheel or beside it, how full its tank is, and the way out. *@
<root class="riding">
	@if ( Player.Local is { Seat: { Vehicle: { } vehicle } seat } )
	{
		<div class="card bar">
			<h1>@(seat.Driver ? $"At the wheel of the {vehicle.Title.ToLowerInvariant()}" : $"In the {vehicle.Title.ToLowerInvariant()}")</h1>
			<div class="track"><div class="fill" style=@($"width: {vehicle.Gauge * 100:0}%;")></div></div>
			<div class="muted">@(seat.Driver ? "Walk to drive, jump to brake. Use gets out." : "Use gets out.")</div>
		</div>
	}
</root>

@code
{
	protected override int BuildHash() => HashCode.Combine( Player.Local?.Seat, Player.Local?.Seat?.Vehicle?.Gauge );
}
