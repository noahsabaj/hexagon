@using Sandbox;
@using Sandbox.UI;
@using Hexagon.Inventory;
@using Hexagon.Items;

@namespace Hexagon.UI
@inherits Panel

@if ( Snapshot != null )
{
	<div class="inv-grid" style="width: @(Snapshot.Width * CellSize)px; height: @(Snapshot.Height * CellSize)px;">
		@for ( int y = 0; y < Snapshot.Height; y++ )
		{
			@for ( int x = 0; x < Snapshot.Width; x++ )
			{
				<div class="hex-grid-cell"
					 style="width: @(CellSize)px; height: @(CellSize)px; left: @(x * CellSize)px; top: @(y * CellSize)px; position: absolute;" />
			}
		}

		@foreach ( var item in Snapshot.Items )
		{
			var def = ItemManager.GetDefinition( item.DefinitionId );
			var w = def?.Width ?? 1;
			var h = def?.Height ?? 1;

			<div class="hex-grid-item"
				 style="left: @(item.X * CellSize)px; top: @(item.Y * CellSize)px; width: @(w * CellSize - 2)px; height: @(h * CellSize - 2)px;"
				 onclick="@(() => OnItemClick?.Invoke( item ))"
				 onmouseover="@(() => OnItemHover?.Invoke( item ))"
				 onmouseout="@(() => OnItemHoverOut?.Invoke())"
				 oncontextmenu="@(() => OnItemContextMenu?.Invoke( item ))">
				<span class="item-name">@(def?.DisplayName ?? "?")</span>
			</div>
		}
	</div>
}

@code
{
	[Property] public InventorySnapshot Snapshot { get; set; }
	[Property] public int CellSize { get; set; } = 64;

	[Property] public Action<ItemSnapshot> OnItemClick { get; set; }
	[Property] public Action<ItemSnapshot> OnItemHover { get; set; }
	[Property] public Action OnItemHoverOut { get; set; }
	[Property] public Action<ItemSnapshot> OnItemContextMenu { get; set; }
}
