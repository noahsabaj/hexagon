@using Sandbox
@using Sandbox.UI
@namespace Hexagon.V2.Client.Chat
@inherits Panel

@* PHASE 1 SPIKE. Hexagon has never shipped a .razor: it is a platform-whitelisted LIBRARY, and the
   whole framework-owned chat design rests on a library being able to ship a panel at all. Panel lives
   in Sandbox.Engine, which is on the assembly whitelist, so this is expected to pass - but expected
   is not proven, and finding out in Phase 5 would be finding out too late.

   Deleted once the real panel replaces it. *@

<root class="hex-chat-probe">
	<label>@Text</label>
</root>

@code
{
	[Parameter] public string Text { get; set; } = "hexagon library razor: alive";

	private bool _announced;

	protected override int BuildHash() => System.HashCode.Combine( Text );

	// Compiling is not rendering. This fires only if the engine actually built and laid out a panel
	// whose type ships from the LIBRARY package, which is the thing being proven.
	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		if ( _announced ) return;
		_announced = true;
		Log.Info( $"HEXAGON_LIBRARY_RAZOR_RENDERED type={GetType().FullName} rect={Box.Rect.Width}x{Box.Rect.Height}" );
	}
}
